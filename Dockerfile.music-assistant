# syntax=docker/dockerfile:1
ARG MA_IMAGE=ghcr.io/music-assistant/server:2.10.6@sha256:45fdb050e06962097a07feeb092606ad119fac17965c8228a57146448d5fa772
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.2@sha256:6dbd7c42a9088083fa79e41431a579196a189bcee3ae68ba904ac2bf77765867
FROM ${UV_IMAGE} AS uv
FROM ${MA_IMAGE}

COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml /opt/devialet-air/pyproject.toml
COPY README.md LICENSE NOTICE /opt/devialet-air/
COPY src /opt/devialet-air/src
COPY music_assistant_provider/devialet_air /opt/devialet-air/provider

RUN /app/venv/bin/python -c \
    "from importlib.metadata import version; assert version('music_assistant') == '2.10.6'"
RUN uv pip install --python /app/venv/bin/python --no-deps /opt/devialet-air
RUN /app/venv/bin/python -c \
    "import importlib.util,pathlib,shutil; p=pathlib.Path(importlib.util.find_spec('music_assistant').origin).parent; shutil.copytree('/opt/devialet-air/provider', p/'providers'/'devialet_air')"
RUN /app/venv/bin/python -c \
    "import music_assistant.providers.devialet_air; from devialet_air import AirClient,Discovery"
